<?xml version="1.0"?>
<!-- 示例：简化的左手两指模型（纯几何体，无 mesh 依赖，可直接上传测试） -->
<robot name="left_hand_demo">
  <link name="left_palm">
    <inertial><mass value="0.2"/><origin xyz="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><origin xyz="0 0 0.03"/><geometry><box size="0.08 0.09 0.025"/></geometry></visual>
    <collision><origin xyz="0 0 0.03"/><geometry><box size="0.08 0.09 0.025"/></geometry></collision>
  </link>

  <link name="left_thumb_prox">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.02"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.008" length="0.04"/></geometry></visual>
  </link>
  <joint name="left_thumb_joint1" type="revolute">
    <parent link="left_palm"/><child link="left_thumb_prox"/>
    <origin xyz="0.045 0.03 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="2" velocity="3"/>
  </joint>

  <link name="left_thumb_dist">
    <inertial><mass value="0.02"/><origin xyz="0 0 0.015"/><inertia ixx="0.000008" ixy="0" ixz="0" iyy="0.000008" iyz="0" izz="0.000008"/></inertial>
    <visual><origin xyz="0 0 0.015"/><geometry><cylinder radius="0.007" length="0.03"/></geometry></visual>
  </link>
  <joint name="left_thumb_joint2" type="revolute">
    <parent link="left_thumb_prox"/><child link="left_thumb_dist"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.4" effort="1" velocity="3"/>
  </joint>

  <link name="left_index_prox">
    <inertial><mass value="0.03"/><origin xyz="0 0 0.025"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.008" length="0.05"/></geometry></visual>
  </link>
  <joint name="left_index_joint1" type="revolute">
    <parent link="left_palm"/><child link="left_index_prox"/>
    <origin xyz="0.02 0.05 0.0425" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.2" upper="1.57" effort="2" velocity="3"/>
  </joint>

  <link name="left_index_dist">
    <inertial><mass value="0.02"/><origin xyz="0 0 0.02"/><inertia ixx="0.000008" ixy="0" ixz="0" iyy="0.000008" iyz="0" izz="0.000008"/></inertial>
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.007" length="0.04"/></geometry></visual>
  </link>
  <joint name="left_index_joint2" type="revolute">
    <parent link="left_index_prox"/><child link="left_index_dist"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.5" effort="1" velocity="3"/>
  </joint>
</robot>
